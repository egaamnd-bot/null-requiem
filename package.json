{
  "name": "null-requiem",
  "version": "0.1.0",
  "private": true,
  "description": "NULL REQUIEM — an original 2D urban-cyberpunk action Metroidvania with a personal rewind (Backtrace), built with Phaser 4.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:build": "tsx tools/assets/build.ts",
    "assets:validate": "tsx tools/assets/build.ts --validate-only",
    "docs:assets": "UPDATE_ASSET_DOCS=1 vitest run tests/docs.test.ts"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
