{
  "name": "null-requiem",
  "version": "0.1.0",
  "private": true,
  "description": "NULL REQUIEM — an original 2D urban-cyberpunk action Metroidvania with a personal rewind (Backtrace), built with Phaser 4.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:sprites": "node assets-src/pack01/build-sprites.mjs",
    "assets:audio": "node --experimental-strip-types --no-warnings assets-src/pack01/audio/render-wavs.ts",
    "assets:pack01": "npm run assets:sprites && npm run assets:audio"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
